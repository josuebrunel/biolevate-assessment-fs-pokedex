package views

import (
	"encoding/json"

)

// Meta is the per-page head content: title, description and sharing tags.
type Meta struct {
	Title       string
	Description string
	URL         string // absolute, for og:url
	Image       string // absolute, for og:image
	NoIndex     bool
	Assets      string // cache-busting version for static files
}

const siteName = "Chen Lab Pokédex"

// htmxConfig keeps htmx within the Content-Security-Policy (no inline styles,
// no eval) and lets error responses swap in so failures are visible.
const htmxConfig = `{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false,"responseHandling":[{"code":".*","swap":true}]}`

func jsonLD(m Meta) string {
	b, _ := json.Marshal(map[string]any{
		"@context":            "https://schema.org",
		"@type":               "WebApplication",
		"name":                siteName,
		"url":                 m.URL,
		"applicationCategory": "ReferenceApplication",
		"operatingSystem":     "Any",
		"description":         m.Description,
	})
	return string(b) // json.Marshal escapes <, > and &, so this is safe inside a script tag
}

templ Layout(m Meta, active string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ m.Title }</title>
			<meta name="description" content={ m.Description }/>
			if m.NoIndex {
				<meta name="robots" content="noindex"/>
			}
			<meta property="og:title" content={ m.Title }/>
			<meta property="og:description" content={ m.Description }/>
			<meta property="og:type" content="website"/>
			<meta property="og:url" content={ m.URL }/>
			<meta property="og:image" content={ m.Image }/>
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content={ m.Title }/>
			<meta name="twitter:description" content={ m.Description }/>
			<meta name="twitter:image" content={ m.Image }/>
			<meta name="theme-color" content="#0e1030"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			@templ.Raw(`<script type="application/ld+json">` + jsonLD(m) + `</script>`)
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Nunito:wght@600;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href={ "/static/app.css?v=" + m.Assets }/>
			<script src={ "/static/htmx.min.js?v=" + m.Assets } defer></script>
			<script src={ "/static/app.js?v=" + m.Assets } defer></script>
		</head>
		<body hx-boost="true">
			<a class="skip" href="#main">Skip to results</a>
			<header class="site-header">
				<div class="wrap">
					<a class="brand" href="/" aria-label="Chen Lab Pokédex, home">
						<svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="14" r="12" fill="none" stroke="currentColor" stroke-width="2.5"></circle><path d="M2 14h24" stroke="currentColor" stroke-width="2.5"></path><circle cx="14" cy="14" r="4.5" fill="currentColor" stroke="currentColor" stroke-width="2.5"></circle></svg>
						{ siteName }
					</a>
					<nav aria-label="Main">
						<a href="/" if active == "search" { aria-current="page" }>Search</a>
						<a href="/compare" if active == "compare" { aria-current="page" }>Battle</a>
					</nav>
				</div>
			</header>
			<main id="main">
				{ children... }
			</main>
			<footer>
				<div class="wrap">
					<p>Data: PokéAPI snapshot of the Kanto Pokédex, with moves from Red, Blue and Yellow. Heights in metres, weights in kilograms, base stats out of 255.</p>
					<p>Abilities come from current PokéAPI data, so some did not exist in the first generation.</p>
				</div>
			</footer>
		</body>
	</html>
}
