package views

// Icon draws one of the app's small hand-made icons. They are decorative (the
// text beside them says the same thing), so they are hidden from screen readers.
// All use a 24px grid, a 2.4 round stroke and currentColor, so they follow the theme.
templ Icon(name string) {
	<svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
		switch name {
			case "search":
				<circle cx="10.5" cy="10.5" r="6.5"></circle>
				<path d="M15.5 15.5 21 21"></path>
			case "battle":
				<path d="M5 19 17 7M14 5l5-1-1 5"></path>
				<path d="M19 19 7 7M10 5 5 4l1 5"></path>
			case "bolt":
				<path d="M13 2 5 13.5h6L10 22l9-12.5h-6z"></path>
			case "moon-z":
				<path d="M19 15.5A8 8 0 0 1 8.5 5a8 8 0 1 0 10.5 10.5z"></path>
			case "rain":
				<path d="M7 15a4.5 4.5 0 0 1-.5-8.9A6 6 0 0 1 18 7.5 3.8 3.8 0 0 1 17.5 15z"></path>
				<path d="M8 18.5 7 21M12.5 18.5l-1 2.5M17 18.5l-1 2.5"></path>
			case "partial":
				<path d="M4 8h9M4 12h6"></path>
				<path d="M14 15h6" stroke-dasharray="1 3.5"></path>
				<path d="M4 16h4"></path>
			case "move":
				<path d="M4 20 15 9"></path>
				<path d="m13 4 7 7-3 1-5-5z"></path>
			case "ability":
				<path d="m12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.5 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"></path>
			case "shield":
				<path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"></path>
			case "minus":
				<path d="M5 12h14"></path>
			case "plus":
				<path d="M12 5v14M5 12h14"></path>
			case "check":
				<path d="m5 12.5 4.5 4.5L19 7.5"></path>
			case "party":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M3 12h18"></path>
				<circle cx="12" cy="12" r="2.6"></circle>
		}
	</svg>
}
