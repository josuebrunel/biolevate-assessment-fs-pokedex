package views

import "github.com/josuebrunel/biolevate-assessment-fs-pokedex/internal/store"

templ ComparePage(m Meta, c Compare) {
	@Layout(m, "compare") {
		<div class="wrap battle">
			<h1>Battle</h1>
			if len(c.Pokemon) < 2 {
				<div class="empty">
					<h2>Nothing to compare yet</h2>
					<p class="note">Search, then tap “Add to party” on two or three Pokémon.</p>
					<a class="btn" href="/?q=fast+electric">@Icon("search") Search “fast electric”</a>
				</div>
			} else {
				<p class="note">Highest base stat in each row wins the round (▲). Most rounds wins the battle.</p>
				@CompareTable(c)
			}
		</div>
	}
}

templ CompareTable(c Compare) {
	<div class="cmp-wrap">
		<table class="cmp">
			<thead>
				<tr>
					<th scope="col"><span class="visually-hidden">Measure</span></th>
					for i, p := range c.Pokemon {
						<th scope="col">
							<div class="head">
								@compareHead(p)
								if c.Winner[i] {
									<span class="crown">Winner</span>
								}
							</div>
						</th>
					}
				</tr>
			</thead>
			<tbody>
				for _, r := range c.Rows {
					<tr>
						<th scope="row">{ r.Label }</th>
						for _, cell := range r.Cells {
							<td class={ bestClass(cell.Best) }>
								<span class="v">{ cell.Text }</span>
								if cell.Percent > 0 {
									<div class="bar" aria-hidden="true"><i style={ "width:" + count(cell.Percent) + "%" }></i></div>
								}
							</td>
						}
					</tr>
				}
				<tr class="rounds">
					<th scope="row">Rounds</th>
					for _, n := range c.Rounds {
						<td><span class="v">{ count(n) }</span></td>
					}
				</tr>
			</tbody>
		</table>
	</div>
}

templ compareHead(p store.Pokemon) {
	<div class={ tileClass(p) } aria-hidden="true"><span class="dex">{ dex(p) }</span></div>
	<h3>{ Title(p.Name) }</h3>
	<span class="badges">
		for _, t := range p.Types {
			<span class={ badgeClass(t) }>{ t }</span>
		}
	</span>
}

func bestClass(best bool) string {
	if best {
		return "best"
	}
	return ""
}
