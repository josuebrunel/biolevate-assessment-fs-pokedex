package views

import "strconv"

// ErrorView is what an error page shows.
type ErrorView struct {
	Status    int
	Message   string
	RequestID string
}

templ ErrorPage(m Meta, e ErrorView) {
	@Layout(m, "") {
		<div class="wrap">
			@ErrorBody(e)
		</div>
	}
}

// ErrorBody is also the fragment swapped in when a live search fails.
templ ErrorBody(e ErrorView) {
	<div class="error-page" role="alert">
		<p class="note">Error { strconv.Itoa(e.Status) }</p>
		<h1>{ e.Message }</h1>
		<p class="note">Try again, or go back to the search. If it keeps happening, quote the request ID below.</p>
		<a class="btn" href="/">Back to search</a>
		if e.RequestID != "" {
			<p class="rid">Request ID: { e.RequestID }</p>
		}
	</div>
}
